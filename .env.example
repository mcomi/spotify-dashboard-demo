# Create a Spotify app at https://developer.spotify.com/dashboard
# Add this exact redirect URI to that app:
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback

SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Fill this after running: npm run spotify:auth
SPOTIFY_REFRESH_TOKEN=

# Used by the private dashboard login.
DASHBOARD_ACCESS_TOKEN=change_this_private_dashboard_token

# Used by Vercel Cron or the GitHub Actions fallback.
CRON_SECRET=change_this_cron_secret

# Upstash Redis REST credentials from Vercel Marketplace.
# Local development can run without these and will use data/spotify-snapshot.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Without this, the AI brief uses a local heuristic fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional free local AI fallback. Install Ollama and run:
# ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=60000
AI_FALLBACK_ON_ERROR=true

# Optional local/demo limits to keep refreshes fast.
SPOTIFY_SAVED_TRACK_LIMIT=200
SPOTIFY_SAVED_ALBUM_LIMIT=100
SPOTIFY_PLAYLIST_LIMIT=20
SPOTIFY_PLAYLIST_DETAIL_LIMIT=8
SPOTIFY_PLAYLIST_TRACK_LIMIT=100
